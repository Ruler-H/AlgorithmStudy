    "# 점 찍기\n",
    "import math\n",
    "\n",
    "\n",
    "def solution(k, d):\n",
    "    answer = 0\n",
    "    for x in range(0, d + 1, k):\n",
    "        max_y = math.isqrt(d * d - x * x)\n",
    "        answer += max_y // k + 1\n",
    "    return answer\n",
    "\n",
    "solution(2, 4) # 6\n",
    "# solution(1, 5) # 26"
   ]
