   "source": [
    "# n^2 배열 자르기\n",
    "def solution(n, left, right):\n",
    "    return [max(k // n, k % n) + 1 for k in range(left, right + 1)]\n",
    "\n",
    "# solution(3, 2, 5) # [3,2,2,3]\n",
    "solution(4, 7, 14) # [4,3,3,3,4,4,4,4]"
   ]
